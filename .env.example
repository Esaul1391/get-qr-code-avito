# Рабочие данные DEV-копии. По умолчанию: <project>/.runtime/dev
# AVITO_DEV_RUNTIME_DIR=/absolute/path/to/separate/runtime

# Необязательный системный путь для этикеток. Его можно переопределить в popup.
# Linux:   AVITO_DEV_LABELS_DIR=/home/user/AvitoLabels
# Windows: AVITO_DEV_LABELS_DIR=C:\Users\User\Documents\AvitoLabels

# Физическая печать намеренно отключена для безопасного тестирования.
AVITO_DEV_PRINT_ENABLED=false
AVITO_DEV_PRINTER_NAME=XP-DT426B
AVITO_DEV_SQL_ECHO=false
